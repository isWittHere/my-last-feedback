{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:\\Users\\<YOUR_USER>\\.codex\\hooks\\scripts\\inject-agent-name.mjs",
            "statusMessage": "Injecting MLFB agent_name",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node C:\\Users\\<YOUR_USER>\\.codex\\hooks\\scripts\\inject-agent-name.mjs",
            "statusMessage": "Injecting MLFB agent_name before compact",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node C:\\Users\\<YOUR_USER>\\.codex\\hooks\\scripts\\inject-agent-name.mjs",
            "statusMessage": "Injecting MLFB agent_name after compact",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:\\Users\\<YOUR_USER>\\.codex\\hooks\\scripts\\inject-agent-name.mjs",
            "statusMessage": "Injecting MLFB agent_name before turn stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
