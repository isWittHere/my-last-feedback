{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ~/.copilot/hooks/scripts/inject-agent-name.mjs",
        "windows": "cmd /c node \"%USERPROFILE%\\.copilot\\hooks\\scripts\\inject-agent-name.mjs\"",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node ~/.copilot/hooks/scripts/inject-agent-name.mjs",
        "windows": "cmd /c node \"%USERPROFILE%\\.copilot\\hooks\\scripts\\inject-agent-name.mjs\"",
        "timeout": 5
      }
    ]
  }
}
